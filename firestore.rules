rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(driverId) {
      return request.auth != null && request.auth.uid == driverId;
    }

    function validCoordinates(value) {
      return value is map
        && value.keys().hasOnly(['latitude', 'longitude'])
        && value.keys().hasAll(['latitude', 'longitude'])
        && value.latitude is number
        && value.longitude is number
        && value.latitude >= -90 && value.latitude <= 90
        && value.longitude >= -180 && value.longitude <= 180;
    }

    function canReceiveRequests() {
      return request.auth != null
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.approvalStatus in ['approved', 'approved_demo']
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.available == true;
    }

    match /drivers/{driverId} {
      allow get: if isOwner(driverId);
      allow list: if false;

      // AI-assisted: see docs/AI_LOG.md #15
      allow create: if isOwner(driverId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'vehicleCategory', 'approvalStatus', 'registrationMode',
          'photoStatus', 'available', 'location', 'locationUpdatedAt',
          'createdAt', 'updatedAt', 'identityNumber', 'phone', 'birthDate',
          'gender', 'email', 'language', 'plate', 'brand', 'model',
          'year', 'color', 'capacity'
        ])
        && request.resource.data.keys().hasAll([
          'displayName', 'vehicleCategory', 'approvalStatus', 'registrationMode',
          'photoStatus', 'available', 'location', 'locationUpdatedAt',
          'createdAt', 'updatedAt', 'identityNumber', 'phone', 'birthDate',
          'gender', 'email', 'language', 'plate', 'brand', 'model',
          'year', 'color', 'capacity'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.identityNumber is string
        && request.resource.data.identityNumber.matches('^[0-9]{6,10}$')
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10}$')
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.gender in ['female', 'male', 'other']
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.language in ['es', 'en']
        && request.resource.data.vehicleCategory in ['economy', 'xl', 'premium']
        && request.resource.data.plate is string
        && request.resource.data.plate.matches('^[A-Z]{3}[0-9]{3}$')
        && request.resource.data.brand is string
        && request.resource.data.brand.size() > 0
        && request.resource.data.brand.size() <= 30
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 30
        && request.resource.data.year is string
        && request.resource.data.year.matches('^[0-9]{4}$')
        && request.resource.data.color in ['white', 'black', 'gray', 'silver', 'blue', 'red', 'other']
        && request.resource.data.capacity is string
        && request.resource.data.capacity.matches('^[0-9]+$')
        && request.resource.data.approvalStatus == 'pending_demo'
        && request.resource.data.registrationMode == 'demo'
        && request.resource.data.photoStatus == 'local_only'
        && request.resource.data.available == false
        && request.resource.data.location == null
        && request.resource.data.locationUpdatedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(driverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'available', 'location', 'locationUpdatedAt', 'updatedAt'
        ])
        && request.resource.data.available is bool
        && request.resource.data.locationUpdatedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.available == false && request.resource.data.location == null)
          || (
            resource.data.approvalStatus in ['approved_demo', 'approved']
            && request.resource.data.available == true
            && validCoordinates(request.resource.data.location)
          )
        );

      allow delete: if false;
    }

    // AI-assisted: see docs/AI_LOG.md #22
    match /tripRequests/{requestId} {
      allow get: if request.auth != null
        && (resource.data.acceptedBy == request.auth.uid
          || (canReceiveRequests() && resource.data.status == 'requested'));
      allow list: if canReceiveRequests()
        && resource.data.status == 'requested'
        && request.query.limit <= 20;
      allow create, delete: if false;
      // AI-assisted: see docs/AI_LOG.md #24
      allow update: if canReceiveRequests()
        && resource.data.status == 'requested'
        && resource.data.expiresAt is timestamp
        && (
          (resource.data.createdAt is timestamp
            && resource.data.expiresAt == resource.data.createdAt + duration.value(15, 's')
            && resource.data.expiresAt > request.time
            && resource.data.acceptedBy == null
            && !exists(/databases/$(database)/documents/tripRequests/$(requestId)/responses/$(request.auth.uid))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedBy', 'acceptedAt'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.acceptedAt == request.time)
          || (resource.data.expiresAt <= request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'expired')
        );

      match /responses/{driverUid} {
        allow get: if request.auth != null && request.auth.uid == driverUid;
        allow list, update, delete: if false;
        allow create: if canReceiveRequests()
          && request.auth.uid == driverUid
          && get(/databases/$(database)/documents/tripRequests/$(requestId)).data.status == 'requested'
          && get(/databases/$(database)/documents/tripRequests/$(requestId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(['status', 'respondedAt'])
          && request.resource.data.keys().hasAll(['status', 'respondedAt'])
          && request.resource.data.status == 'rejected'
          && request.resource.data.respondedAt == request.time;
      }
    }

    function completedTripFields() {
      return [
        'requestId', 'driverId', 'passengerName', 'origin', 'destination',
        'distanceKm', 'durationMin', 'category', 'paymentMethod',
        'fare', 'commission', 'driverEarnings', 'commissionRate', 'tip',
        'status', 'paymentStatus', 'paymentId', 'createdAt', 'completedAt'
      ];
    }

    // AI-assisted: see docs/AI_LOG.md #35
    match /trips/{tripId} {
      allow get: if request.auth != null
        && ((resource != null && resource.data.driverId == request.auth.uid)
          || (resource == null
            && exists(/databases/$(database)/documents/tripRequests/$(tripId))
            && get(/databases/$(database)/documents/tripRequests/$(tripId)).data.acceptedBy == request.auth.uid));
      allow list: if false;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/tripRequests/$(tripId))
        && request.resource.data.keys().hasOnly(completedTripFields())
        && request.resource.data.keys().hasAll(completedTripFields())
        && get(/databases/$(database)/documents/tripRequests/$(tripId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/tripRequests/$(tripId)).data.acceptedBy == request.auth.uid
        && request.resource.data.requestId == tripId
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.passengerName == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.passengerName
        && request.resource.data.origin == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.origin
        && request.resource.data.destination == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.destination
        && request.resource.data.distanceKm == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.distanceKm
        && request.resource.data.durationMin == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.durationMin
        && request.resource.data.category == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.category
        && request.resource.data.paymentMethod == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.paymentMethod
        && request.resource.data.fare == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.fare
        && request.resource.data.commission == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.commission
        && request.resource.data.driverEarnings == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.driverEarnings
        && request.resource.data.createdAt == get(/databases/$(database)/documents/tripRequests/$(tripId)).data.createdAt
        && request.resource.data.commissionRate == 0.2
        && request.resource.data.tip == 0
        && request.resource.data.status == 'completed'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentId == null
        && request.resource.data.completedAt == request.time;
      allow update, delete: if false;
    }
  }
}
